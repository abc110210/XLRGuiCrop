<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xlingran</groupId>
    <artifactId>XLRGuiCrop</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>XLRGuiCrop</name>
    <description>Multi-Functional Virtual Crops Plugin</description>

    <properties>
        <!-- Java 25（用户指定） -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Spigot 官方 snapshot 仓库（Spigot API 26.2） -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- VaultAPI（jitpack） -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot API 26.2（构建期 provided，与本地 SpigotmcApi.md 版本一致） -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>26.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite JDBC（shade 打包进 jar，排除签名文件） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <!-- Vault 经济 API（构建期 provided，不进 jar；运行时需服务端安装 Vault） -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 用户约定：源码目录为 src/main，包 xlingran.com 对应 src/main/xlingran/com/ -->
        <sourceDirectory>src/main</sourceDirectory>
        <resources>
            <!-- plugin.yml / config.yml / gui.yml 按约定放项目根目录（与 src 同级），构建时复制进 jar，
                 首次启动由 ConfigLoader 释放到插件数据目录 -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                    <include>gui.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 编译器：release 25，需 3.14.1+ 支持 Java 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <!-- 防御：GitHub 仓库曾残留「src/main 目录被整体复制进 com 内」的嵌套源码副本
                         （src/main/xlingran/com/src/main/xlingran/com/...），导致 10 个 duplicate class。
                         正确源码相对 sourceDirectory 位于 xlingran/com/ 下、不含 src/main 段，不受影响。
                         根治：删除仓库中的嵌套目录，勿长期依赖此排除。 -->
                    <excludes>
                        <exclude>**/src/main/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- shade：打包 sqlite-jdbc 并排除签名文件，避免 "Invalid signature" 启动错误 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- 合并 JDBC 驱动服务描述，避免 jdbc:sqlite 找不到驱动 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/services/java.sql.Driver</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- 瘦身：sqlite-jdbc 自带全平台原生库（org/sqlite/native/），
                                     仅保留三平台：Linux x86_64（amd64）、Windows x86_64、Linux aarch64（arm64）。
                                     若需增减平台，调整 exclude 列表即可。 -->
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv5/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64le/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/s390x/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/Solaris/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
